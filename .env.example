# ==============================================================================
# Domain-Specific Technical RAG Engine Environment Configuration
# ==============================================================================

# Application Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# FastAPI Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:8501","http://localhost:8000"]

# Pipeline Execution Mode: 'groq' (Cloud API) or 'llama_cpp' (Local CPU GGUF)
LLM_PROVIDER=llama_cpp

# Option A: Groq Cloud API Settings (For cloud demo deployment)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Option B: Local GGUF Model Options (Placed inside models/ directory)
LLM_MODEL=bartowski/Qwen2.5-3B-Instruct-GGUF
LLM_MODEL_FILE=Qwen2.5-3B-Instruct-Q8_0.gguf

# Embedding & Re-Ranking Models (Downloaded automatically via HuggingFace)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Retrieval Parameters
RETRIEVAL_TOP_K=15
SIMILARITY_THRESHOLD=0.3
RERANK_TOP_K=5

# Public Demo Safety Guardrails
MAX_FILE_SIZE_MB=5
MAX_INDEXED_CHUNKS=1000
RATE_LIMIT_QUERY=15/minute
RATE_LIMIT_UPLOAD=5/minute