# Application Configuration Environment Variables
ENVIRONMENT=production
LOG_LEVEL=INFO

# API Server Options
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:8501","http://localhost:8000"]

# Model Configurations
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL=bartowski/Qwen2.5-3B-Instruct-GGUF
LLM_MODEL_FILE=Qwen2.5-3B-Instruct-Q8_0.gguf

# Public Demo Limits
MAX_FILE_SIZE_MB=5
MAX_INDEXED_CHUNKS=1000
RATE_LIMIT_QUERY=15/minute
RATE_LIMIT_UPLOAD=5/minute